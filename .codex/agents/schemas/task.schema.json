{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkout-workbench.local/.codex/agents/schemas/task.schema.json",
  "title": "Checkout Workbench Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "workflow",
    "priority",
    "objective",
    "context_refs",
    "roles",
    "acceptance_criteria",
    "validation_commands",
    "sensitive_data_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "pattern": "^P[0-4](-P[0-4])?$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assignment", "deliverables"],
        "properties": {
          "id": {
            "$ref": "#/$defs/roleId"
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitive_data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_only",
        "raw_logs_allowed",
        "summaries_allowed",
        "pin_values_allowed_only_when_audit_capture_sensitive_is_enabled"
      ],
      "properties": {
        "local_only": {
          "type": "boolean"
        },
        "raw_logs_allowed": {
          "type": "boolean"
        },
        "summaries_allowed": {
          "type": "boolean"
        },
        "pin_values_allowed_only_when_audit_capture_sensitive_is_enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "roleId": {
      "enum": [
        "automation-architect",
        "backend-cdp-engineer",
        "frontend-workflow-ux",
        "operations-user-representative"
      ]
    }
  }
}
